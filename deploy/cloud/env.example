# SupaPIM (Supabase Cloud): copy to .env and fill in. Guide: docs/install-cloud.md

# The plugin image (replaced by the registry address if you pull instead of load)
CMS_IMAGE=ghcr.io/hammerschmied-group/supapim:@VERSION@

# Your project, Settings → API: Project URL, and the publishable key (sb_publishable_…, or the legacy anon key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Settings → API Keys → secret key (sb_secret_…). Only the admin API uses it, to invite and block people.
# Used only by the separate admin container (docker compose --profile admin up -d). Without it, invite people in the dashboard.
SUPABASE_SECRET_KEY=

# Where THIS container is reachable on the internet, https, no path: the CMS opens at <this>/cms/, MCP at <this>/cms/mcp.
# Set the project's Site URL (Authentication → URL Configuration) to exactly this address.
CMS_PUBLIC_URL=https://cms.example.com

# Only for `docker compose --profile caddy up -d`: the domain Caddy serves (DNS must point at this host)
#CMS_DOMAIN=cms.example.com

# mail = Auth sends the invitation (custom SMTP in the project strongly recommended); link = the admin gets the link
#CMS_ADMIN_INVITE_DELIVERY=mail

# Port on the host; bind address (127.0.0.1 behind your own reverse proxy, 0.0.0.0 to publish)
#CMS_PORT=8080
#CMS_BIND=127.0.0.1
