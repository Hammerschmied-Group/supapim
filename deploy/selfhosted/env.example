# SupaPIM — values for the .env of the Supabase docker directory.
# `cms/install.sh env` adds what is missing; you only edit values marked (yours).

# The plugin image. Replaced by the registry address if you pull instead of load (docs/install-selfhosted.md, step 2).
CMS_IMAGE=ghcr.io/hammerschmied-group/supapim:@VERSION@

# Where this package folder is, relative to the Supabase docker directory (default ./cms).
#CMS_PKG_DIR=./cms

# (yours) Mail links (invitation, password reset, magic link) may send the browser back to these addresses; comma separated.
# Default: <SUPABASE_PUBLIC_URL>/cms/**
#CMS_REDIRECT_URLS=https://supabase.example.com/cms/**

# (yours) Where invitation links land (default <SUPABASE_PUBLIC_URL>/cms/); keep it as the exact UI address.
#CMS_PUBLIC_UI_URL=https://supabase.example.com/cms/

# (yours) mail = Auth sends the invitation (needs working SMTP_* below); link = nothing is sent, the admin gets the link.
#CMS_ADMIN_INVITE_DELIVERY=mail

# Existing upstream values the plugin depends on — install.sh env checks them:
#   SUPABASE_PUBLIC_URL=https://supabase.example.com       the one address people and MCP clients use (https for Claude/ChatGPT)
#   API_EXTERNAL_URL=https://supabase.example.com/auth/v1  = SUPABASE_PUBLIC_URL + /auth/v1 (the token issuer)
#   SITE_URL=https://supabase.example.com                  = SUPABASE_PUBLIC_URL (GoTrue opens SITE_URL/oauth/consent for MCP sign-in)
#   PGRST_DB_SCHEMAS=public,graphql_public,cms_api         cms_api added, one entry per brand schema after it
#   JWT_KEYS, JWT_JWKS, SUPABASE_SECRET_KEY                from  sh utils/add-new-auth-keys.sh --update-env
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_ADMIN_EMAIL, SMTP_SENDER_NAME   real mail server (invitations, password reset)
#   COMPOSE_FILE=docker-compose.yml:cms/docker-compose.cms.yml:cms/docker-compose.envoy.yml   (Kong: …kong.yml:cms/docker-compose.cms.yml:cms/docker-compose.kong.yml)
